---
import BaseLayout from '../layouts/BaseLayout.astro';
import { catalogEntries } from '../utils/dataLoader';

// Compute statistics for WERKHub Dashboard
const totalCount = catalogEntries.length;
const averageScore = Math.round(catalogEntries.reduce((sum, item) => sum + item.score, 0) / totalCount);
const officialCount = catalogEntries.filter(item => item.official_status === 'official').length;

// Tiers breakdown
const essentialCount = catalogEntries.filter(item => item.score_label === 'essential').length;
const strongCount = catalogEntries.filter(item => item.score_label === 'strong').length;
const emergingCount = catalogEntries.filter(item => item.score_label === 'emerging').length;
const watchlistCount = catalogEntries.filter(item => item.score_label === 'watchlist').length;

// Top 5 highest rated entries
const topEntries = [...catalogEntries]
  .sort((a, b) => b.score - a.score)
  .slice(0, 5);

const compareCatalog = catalogEntries.map(entry => ({
  id: entry.id,
  name: entry.name,
  repository: entry.repository,
  primary_category: entry.primary_category,
  score: entry.score,
  stars: entry.stars ?? null,
  license: entry.license ?? null,
  maintenance_status: entry.maintenance_status ?? null,
  checked_at: entry.checked_at ?? null,
}));

// Calculate trending projects (Top 3 Momentum)
const trendingProjects = catalogEntries
  .filter(entry => entry.trend_data && entry.trend_data.stars_30d !== null && entry.trend_data.stars_30d !== undefined)
  .map(entry => {
    const currentStars = entry.stars || 0;
    const stars30d = entry.trend_data!.stars_30d || 0;
    const growth = currentStars - stars30d;
    const growthRate = stars30d > 0 ? (growth / stars30d) : 0;
    const momentum = Math.max(0, growth * (1 + growthRate));
    return { ...entry, growth, momentum: Math.round(momentum) };
  })
  .sort((a, b) => b.momentum - a.momentum)
  .slice(0, 3);
---

<BaseLayout title="WERKHub Control Deck">
  <div class="space-y-grid-xl">
    <!-- Main Welcome Terminal -->
    <div class="border-2 border-steel-border bg-graphite-900 p-grid-xl relative overflow-hidden shadow-flat-md">
      <div class="absolute right-4 top-4 font-mono text-[9px] text-graphite-600 bg-graphite-950 border border-steel-border px-1.5 py-0.5">
        SYS_STATUS: ONLINE // BRND: COOL_GRAPHITE
      </div>
      <h2 class="text-graphite-50 font-mono text-lg font-bold mb-grid-sm flex items-center gap-2">
        <span class="text-caution-yellow">■</span> WERKAtlas Dashboard // Ecosystem Control Deck
      </h2>
      <p class="text-graphite-400 max-w-4xl text-xs leading-relaxed font-mono">
        Indexierte Repositories, SDKs und Entwicklungs-Tools des WERKAgent/WERKCommander-Ökosystems. 
        Datengestützte Bewertung und Klassifizierung aller Komponenten nach Reife, Maintenance und Interoperabilität.
      </p>
    </div>

    <!-- Quick Stats Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-grid-lg">
      <div class="border border-steel-border bg-graphite-900 p-grid-lg shadow-flat-sm">
        <div class="font-mono text-[10px] text-graphite-600 uppercase">Erfasste Repositories</div>
        <div class="text-3xl font-mono font-bold text-graphite-50 mt-grid-xs">{totalCount}</div>
      </div>
      <div class="border border-steel-border bg-graphite-900 p-grid-lg shadow-flat-sm">
        <div class="font-mono text-[10px] text-graphite-600 uppercase">Durchschnittlicher Score</div>
        <div class="text-3xl font-mono font-bold text-caution-yellow mt-grid-xs">{averageScore} <span class="text-xs text-graphite-600">/ 100</span></div>
      </div>
      <div class="border border-steel-border bg-graphite-900 p-grid-lg shadow-flat-sm">
        <div class="font-mono text-[10px] text-graphite-600 uppercase">Offizielle Hersteller-Projekte</div>
        <div class="text-3xl font-mono font-bold text-graphite-50 mt-grid-xs">{officialCount}</div>
      </div>
    </div>

    <!-- Ecosystem Status & Rankings -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-grid-xl">
      <!-- Left Column: Tier Distribution & Trending -->
      <div class="space-y-grid-xl">
        <!-- Tiers -->
        <div class="border border-steel-border bg-graphite-900 p-grid-lg space-y-grid-md shadow-flat-sm">
          <h3 class="text-graphite-100 font-mono text-xs font-bold uppercase tracking-widest border-b border-steel-border pb-grid-sm">
            Scoring Tiers
          </h3>
          <div class="space-y-grid-sm font-mono text-xs">
            <div class="flex items-center justify-between border-b border-steel-border/30 pb-1">
              <span class="text-caution-orange">★ Essential (≥85)</span>
              <span class="text-graphite-100 font-bold">{essentialCount}</span>
            </div>
            <div class="flex items-center justify-between border-b border-steel-border/30 pb-1">
              <span class="text-caution-yellow">✦ Strong (75-84)</span>
              <span class="text-graphite-100 font-bold">{strongCount}</span>
            </div>
            <div class="flex items-center justify-between border-b border-steel-border/30 pb-1">
              <span class="text-graphite-300">▪ Emerging (65-74)</span>
              <span class="text-graphite-100 font-bold">{emergingCount}</span>
            </div>
            <div class="flex items-center justify-between border-b border-steel-border/30 pb-1">
              <span class="text-graphite-600">▪ Watchlist (50-64)</span>
              <span class="text-graphite-100 font-bold">{watchlistCount}</span>
            </div>
          </div>
        </div>

        <!-- Dashboard Trending Block -->
        <div class="border border-steel-border bg-graphite-900 p-grid-lg space-y-grid-md shadow-flat-sm">
          <h3 class="text-graphite-100 font-mono text-xs font-bold uppercase tracking-widest border-b border-steel-border pb-grid-sm flex justify-between items-center">
            <span>Trending (30d)</span>
            <a href="/WERKAtlas/trending/" class="text-[9px] text-caution-yellow hover:underline">ALLE ↗</a>
          </h3>
          <div class="space-y-grid-sm font-mono text-[11px]">
            {trendingProjects.map(project => (
              <div class="flex justify-between items-center border-b border-steel-border/30 pb-1">
                <a href={`/WERKAtlas/project/${project.repository.replace('/', '-')}/`} class="text-graphite-100 hover:text-caution-yellow truncate max-w-[150px]">
                  {project.repository}
                </a>
                <span class="text-caution-orange font-bold">+{project.growth} ★</span>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Right Column: Top Curated Components (larger span) -->
      <div class="lg:col-span-2 border border-steel-border bg-graphite-900 p-grid-lg space-y-grid-md shadow-flat-sm">
        <h3 class="text-graphite-100 font-mono text-xs font-bold uppercase tracking-widest border-b border-steel-border pb-grid-sm">
          Top-Bewertete Ecosystem Komponenten
        </h3>
        <div class="space-y-grid-sm">
          {topEntries.map(entry => (
            <div class="flex items-center justify-between font-mono text-xs border border-steel-border/50 bg-graphite-950 p-grid-sm hover:border-steel-glare transition-colors">
              <div class="truncate">
                <a href={`/WERKAtlas/project/${entry.repository.replace('/', '-')}/`} class="text-graphite-100 hover:text-caution-yellow font-bold">
                  {entry.repository}
                </a>
                <span class="text-graphite-600 text-[10px] ml-2 select-none uppercase">// {entry.project_type}</span>
              </div>
              <div class="flex items-center gap-3">
                <button
                  type="button"
                  class="font-mono text-[9px] uppercase border border-steel-border px-1 py-0.5 text-graphite-100 hover:border-caution-yellow"
                  data-testid="compare-btn"
                  data-compare-id={entry.id}
                >
                  Vergleichen
                </button>
                <span class={`text-[9px] px-1 py-0.5 rounded-sm uppercase ${
                  entry.score_label === 'essential' ? 'bg-caution-orange/20 text-caution-orange border border-caution-orange/30' : 'bg-caution-yellow/20 text-caution-yellow border border-caution-yellow/30'
                }`}>
                  {entry.score_label}
                </span>
                <span class="text-caution-yellow font-bold">{entry.score}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <div
      id="comparison-bar"
      data-testid="comparison-bar"
      hidden
      class="border border-caution-yellow bg-graphite-950 p-grid-md font-mono text-xs text-graphite-100 flex flex-wrap items-center gap-3"
    >
      <span>Vergleich <span data-testid="comparison-count">0</span></span>
      <div id="comparison-chips" class="flex flex-wrap gap-2"></div>
      <button type="button" data-testid="clear-comparison-btn" class="border border-steel-border px-2 py-1">Leeren</button>
      <button type="button" data-testid="launch-comparison-btn" class="border border-caution-yellow px-2 py-1 text-caution-yellow">Öffnen</button>
    </div>
    <p id="comparison-limit-toast" data-testid="comparison-limit-toast" hidden class="font-mono text-xs text-caution-orange">
      Maximal 3 Projekte.
    </p>

    <section id="comparison-panel" hidden class="border border-steel-border bg-graphite-900 p-grid-lg space-y-grid-md">
      <p id="comparison-warning" data-testid="comparison-warning" hidden class="font-mono text-xs text-caution-orange">
        Select at least 2 projects.
      </p>
      <div id="comparison-table" data-testid="comparison-table" class="overflow-x-auto font-mono text-xs text-graphite-100"></div>
    </section>
  </div>
</BaseLayout>

<script define:vars={{ compareCatalog }}>
  const MAX_COMPARE = 3;
  const byId = new Map(compareCatalog.map((entry) => [entry.id, entry]));
  const fields = [
    ['name', 'Name'],
    ['primary_category', 'Kategorie'],
    ['score', 'Score'],
    ['stars', 'Stars'],
    ['license', 'Lizenz'],
    ['maintenance_status', 'Wartung'],
    ['checked_at', 'Geprüft'],
  ];
  const bar = document.getElementById('comparison-bar');
  const count = document.querySelector('[data-testid="comparison-count"]');
  const chips = document.getElementById('comparison-chips');
  const clearButton = document.querySelector('[data-testid="clear-comparison-btn"]');
  const launchButton = document.querySelector('[data-testid="launch-comparison-btn"]');
  const toast = document.getElementById('comparison-limit-toast');
  const panel = document.getElementById('comparison-panel');
  const warning = document.getElementById('comparison-warning');
  const table = document.getElementById('comparison-table');
  const buttons = Array.from(document.querySelectorAll('[data-testid="compare-btn"]'));

  const params = new URLSearchParams(window.location.search);
  let selected = (params.get('compare') || '')
    .split(',')
    .map((item) => item.trim())
    .filter(Boolean)
    .slice(0, MAX_COMPARE);

  function cellValue(project, key) {
    if (!project) return null;
    const value = project[key];
    if (value === null || value === undefined || value === '') return null;
    return String(value);
  }

  function renderTable(ids) {
    const fromQuery = new URLSearchParams(window.location.search).has('compare');
    if (!fromQuery) {
      panel.hidden = true;
      return;
    }
    panel.hidden = false;
    warning.hidden = ids.length >= 2;
    table.replaceChildren();
    const header = document.createElement('div');
    header.className = 'grid gap-3';
    header.style.gridTemplateColumns = `repeat(${Math.max(ids.length, 1)}, minmax(0, 1fr))`;
    ids.forEach((id) => {
      const project = byId.get(id);
      const column = document.createElement('div');
      column.dataset.testid = 'comparison-column';
      column.className = 'border border-steel-border p-2';
      column.textContent = project ? project.repository : id;
      header.appendChild(column);
    });
    table.appendChild(header);
    fields.forEach(([key, label]) => {
      const row = document.createElement('div');
      if (key === 'score') row.dataset.testid = 'comparison-row-score';
      row.className = 'grid gap-3 border-t border-steel-border py-1';
      row.style.gridTemplateColumns = `8rem repeat(${Math.max(ids.length, 1)}, minmax(0, 1fr))`;
      const name = document.createElement('span');
      name.textContent = label;
      row.appendChild(name);
      ids.forEach((id) => {
        const value = cellValue(byId.get(id), key);
        const cell = document.createElement('span');
        if (value === null) {
          cell.dataset.testid = 'comparison-val-missing';
          cell.textContent = '-';
        } else {
          cell.textContent = value;
        }
        row.appendChild(cell);
      });
      table.appendChild(row);
    });
  }

  function render() {
    bar.hidden = selected.length === 0;
    count.textContent = String(selected.length);
    chips.replaceChildren();
    selected.forEach((id) => {
      const chip = document.createElement('span');
      chip.className = 'border border-steel-border px-1 py-0.5';
      chip.textContent = id + ' ';
      const remove = document.createElement('button');
      remove.type = 'button';
      remove.dataset.testid = 'remove-compare-item';
      remove.textContent = '×';
      remove.addEventListener('click', () => {
        selected = selected.filter((item) => item !== id);
        render();
      });
      chip.appendChild(remove);
      chips.appendChild(chip);
    });
    buttons.forEach((button) => {
      const id = button.getAttribute('data-compare-id');
      button.disabled = Boolean(id) && !selected.includes(id) && selected.length >= MAX_COMPARE;
    });
    toast.hidden = true;
    renderTable(selected);
  }

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const id = button.getAttribute('data-compare-id');
      if (!id) return;
      if (selected.includes(id)) {
        selected = selected.filter((item) => item !== id);
      } else if (selected.length >= MAX_COMPARE) {
        toast.hidden = false;
        return;
      } else {
        selected = selected.concat(id);
      }
      render();
    });
  });

  clearButton.addEventListener('click', () => {
    selected = [];
    render();
  });

  launchButton.addEventListener('click', () => {
    const url = new URL(window.location.href);
    url.searchParams.set('compare', selected.join(','));
    window.location.assign(url.pathname + '?' + url.searchParams.toString());
  });

  render();
</script>
